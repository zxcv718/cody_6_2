# Codyssey 공개 API 키 (https://usr.codyssey.kr/public-api-console 에서 발급)
#
# 이 파일을 .env 로 복사한 뒤 키를 채우고, 셸에서 아래처럼 불러오세요.
#
#     cp .env.example .env      # 키를 채운다
#     source .env               # 환경변수로 올린다
#     python main.py commit
#
# .env 는 .gitignore 에 걸려 있어 커밋되지 않습니다.
# 프로그램은 파일을 읽지 않고 환경변수만 읽습니다 — 키가 코드/설정 파싱 경로를
# 타지 않도록 하려는 의도입니다.

export AI_API_KEY="sk-cody-live-여기에-발급받은-키"

